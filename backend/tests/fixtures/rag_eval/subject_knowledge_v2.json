      "pages": [
        {"id": "spectra-p1", "number": 1, "text": "A redshift moves spectral lines toward longer wavelengths. In introductory observations it can indicate a source receding from the observer."},
        {"id": "spectra-p2", "number": 2, "text": "A blueshift moves spectral lines toward shorter wavelengths and can indicate approach. This is related to, but not identical with, orbital eccentricity."}
      ]
