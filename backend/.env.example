# Copy to backend/.env for direct backend development. Never commit real values.
APP_NAME="Flashcard Generator"
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false

DATABASE_URL=postgresql+asyncpg://admin:replace-me@localhost:5432/flashcard_gen

# Generate privately with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-at-least-32-random-characters
ALGORITHM=HS256
JWT_ISSUER=flashcard-generator-api
JWT_AUDIENCE=flashcard-generator-web
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_SESSION_EXPIRE_DAYS=30

REFRESH_COOKIE_NAME=flashcard_refresh
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax
# REFRESH_COOKIE_DOMAIN=

FRONTEND_BASE_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# API docs default on outside production and off in production when unset.
# API_ROOT_PATH is empty for a directly exposed development API; the Compose
# frontend proxy uses /api externally and forwards unprefixed paths internally.
API_DOCS_ENABLED=true
API_ROOT_PATH=

# Workers stop claiming new work on SIGTERM, then drain active work for this
# bounded interval before cancellation.
WORKER_SHUTDOWN_GRACE_SECONDS=30

INVITATION_MIN_HOURS=1
INVITATION_MAX_HOURS=720
PASSWORD_RESET_EXPIRE_MINUTES=30

# Email delivery is optional for API and migration processes. The email worker
# requires SMTP_HOST and SMTP_FROM_EMAIL. Production delivery must enable
# exactly one of STARTTLS or implicit TLS; local Mailpit uses neither.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=
SMTP_REPLY_TO=
SMTP_STARTTLS=false
SMTP_IMPLICIT_TLS=false
SMTP_TIMEOUT_SECONDS=15

# Durable transactional-email worker, retry, and retention bounds.
EMAIL_WORKER_CONCURRENCY=4
EMAIL_WORKER_POLL_SECONDS=1
EMAIL_LEASE_SECONDS=240
EMAIL_MAX_ATTEMPTS=5
EMAIL_RETRY_BASE_SECONDS=5
EMAIL_RETRY_MAX_SECONDS=300
EMAIL_CLEANUP_INTERVAL_SECONDS=3600
EMAIL_SENT_RETENTION_DAYS=7
EMAIL_FAILED_RETENTION_DAYS=30
EMAIL_SECURITY_NOTIFICATION_EXPIRE_HOURS=24

# AI provider. The default is a versioned stable Gemini model. Use
# openai_compatible with an operator-controlled hosted or local endpoint.
AI_PROVIDER_ENABLED=false
AI_PROVIDER=gemini
AI_MODEL=gemini-3.8-flash
AI_API_KEY=
# Legacy Gemini-only fallback during migration; prefer AI_API_KEY.
GEMINI_API_KEY=
# Required only for openai_compatible, for example http://model:11434/v1.
AI_BASE_URL=
AI_ALLOW_UNSTABLE_MODEL=false
AI_TEMPERATURE=0.2
AI_MAX_OUTPUT_TOKENS=8192
AI_CONTEXT_WINDOW_TOKENS=1048576
AI_PROVIDER_TIMEOUT_SECONDS=90
# Transient calls receive three retries, each after a three-second wait.
AI_PROVIDER_MAX_RETRIES=3
AI_RETRY_BASE_SECONDS=3
AI_RETRY_MAX_SECONDS=30
AI_CONCURRENCY=3
AI_REQUESTS_PER_MINUTE=5
AI_INPUT_TOKENS_PER_MINUTE=250000
AI_RATE_LIMIT_SAFETY_PERCENT=80
AI_CHUNK_INPUT_TOKENS=1200
AI_CHUNK_OVERLAP_TOKENS=120
AI_REQUEST_INPUT_TARGET_TOKENS=40000
AI_CARDS_PER_REQUEST=10
AI_SUMMARY_OUTPUT_TOKENS=1024
AI_MAX_JOB_INPUT_TOKENS=200000
AI_MAX_JOB_OUTPUT_TOKENS=262144
# Current prices are operator-supplied USD per million tokens. Both zero means
# cost unavailable while token budgets still apply.
AI_INPUT_COST_PER_MILLION_USD=0
AI_OUTPUT_COST_PER_MILLION_USD=0
AI_MAX_ESTIMATED_COST_USD=5
AI_REFILL_ROUNDS=2
AI_DUPLICATE_SIMILARITY_THRESHOLD=0.88

# Required. Generate independently from SECRET_KEY with:
# python -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode().rstrip('='))"
GENERATION_SOURCE_ENCRYPTION_KEY=

# PDF admission and extraction bounds.
PDF_MAX_UPLOAD_BYTES=10485760
PDF_MAX_PAGES=100
PDF_MAX_EXTRACTED_CHARS=500000
PDF_EXTRACTION_TIMEOUT_SECONDS=60
PDF_EXTRACTION_MEMORY_LIMIT_MB=512

# Per-user and deployment admission/cost controls.
GENERATION_MIN_CARD_COUNT=1
GENERATION_MAX_CARD_COUNT=100
GENERATION_MAX_ACTIVE_JOBS_PER_USER=2
GENERATION_MAX_ACTIVE_JOBS_DEPLOYMENT=20
GENERATION_MAX_QUEUED_JOBS_DEPLOYMENT=100
GENERATION_DAILY_JOBS_PER_USER=10
GENERATION_DAILY_CARDS_PER_USER=500
GENERATION_DAILY_UPLOAD_BYTES_PER_USER=104857600
GENERATION_DAILY_JOBS_DEPLOYMENT=1000
GENERATION_DAILY_CARDS_DEPLOYMENT=50000
GENERATION_DAILY_UPLOAD_BYTES_DEPLOYMENT=10737418240
GENERATION_MAX_RETAINED_SOURCE_BYTES_PER_USER=52428800
GENERATION_MAX_RETAINED_SOURCE_BYTES_DEPLOYMENT=1073741824

# Worker concurrency, leases, retries, and retention.
GENERATION_WORKER_CONCURRENCY=2
GENERATION_JOB_TIMEOUT_SECONDS=600
GENERATION_LEASE_SECONDS=60
GENERATION_WORKER_POLL_SECONDS=1
GENERATION_HEARTBEAT_SECONDS=10
GENERATION_MAX_ATTEMPTS=3
GENERATION_MAX_MANUAL_RETRIES=2
GENERATION_RETRY_BASE_SECONDS=2
GENERATION_RETRY_MAX_SECONDS=60
GENERATION_SOURCE_RETRY_RETENTION_HOURS=24
GENERATION_UPLOAD_RESERVATION_MINUTES=15
GENERATION_CLEANUP_INTERVAL_SECONDS=60

# Optional local OCR. Enabling it requires an OCR-enabled worker image.
PDF_OCR_ENABLED=false
PDF_OCR_LANGUAGE=eng
PDF_OCR_DPI=200
PDF_OCR_PAGE_TIMEOUT_SECONDS=30
