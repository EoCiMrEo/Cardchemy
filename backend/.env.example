# Copy to backend/.env for direct backend development. Never commit real values.
APP_NAME="Flashcard Generator"
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false

DATABASE_URL=postgresql+asyncpg://admin:replace-me@localhost:5432/flashcard_gen

# Generate privately with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-at-least-32-random-characters
ALGORITHM=HS256
JWT_ISSUER=flashcard-generator-api
JWT_AUDIENCE=flashcard-generator-web
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_SESSION_EXPIRE_DAYS=30

REFRESH_COOKIE_NAME=flashcard_refresh
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax
# REFRESH_COOKIE_DOMAIN=

FRONTEND_BASE_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

INVITATION_MIN_HOURS=1
INVITATION_MAX_HOURS=720
PASSWORD_RESET_EXPIRE_MINUTES=30
EMAIL_VERIFICATION_REQUIRED=false

# Required in production for password recovery.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_STARTTLS=true

# Optional; live AI tests and generation require it.
GEMINI_API_KEY=
