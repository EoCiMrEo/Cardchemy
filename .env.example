# One supported file: copy/bootstrap this template as repository-root .env.
# The three generated secrets below are deliberately blank. Run
# `python scripts/bootstrap_env.py` once; it never overwrites an existing file.
# See docs/CONFIGURATION.md for each setting's meaning, range, consumer,
# empty-value behavior, and security impact. Process environment wins over .env.

# Compose and local public ports
COMPOSE_PROJECT_NAME=cardchemy
APP_PORT=8080
API_PORT=8000
POSTGRES_PORT=5432
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025

# PostgreSQL (the bootstrap script fills POSTGRES_PASSWORD)
POSTGRES_DB=cardchemy
POSTGRES_USER=admin
POSTGRES_PASSWORD=
# Optional explicit native/external database URL. When empty, native Python
# derives a localhost URL from POSTGRES_*; Compose always injects its db URL.
DATABASE_URL=

# Application identity and generated secrets
APP_NAME=Cardchemy
APP_VERSION=0.1.0
SECRET_KEY=
GENERATION_SOURCE_ENCRYPTION_KEY=

# Safe local defaults. The production override replaces or requires these.
ENVIRONMENT=development
DEBUG=false
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax
FRONTEND_BASE_URL=
CORS_ORIGINS=
API_DOCS_ENABLED=
API_ROOT_PATH=
VITE_API_URL=/api
WORKER_SHUTDOWN_GRACE_SECONDS=30
# Content-free diagnostics; metadata cleanup is operator-run and dry-run first.
LOG_LEVEL=INFO
REQUEST_RETENTION_DAYS=7
GENERATION_JOB_RETENTION_DAYS=30
DATABASE_METADATA_RETENTION_DAYS=30
AUDIT_RETENTION_DAYS=90
RETENTION_BATCH_SIZE=500
WORKER_HEALTH_STALE_SECONDS=60
# Optional aggregate reporting needs explicit enablement and an operator-owned
# HTTPS collector. Nothing is sent until `python -m app.cli report-telemetry`.
TELEMETRY_ENABLED=false
TELEMETRY_ENDPOINT=
TELEMETRY_TIMEOUT_SECONDS=5
# Compose proxy trust should be narrowed if the API is ever exposed directly.
FORWARDED_ALLOW_IPS=

# Optional advanced authentication/session controls (minutes, days, hours).
ALGORITHM=HS256
JWT_ISSUER=cardchemy-api
JWT_AUDIENCE=cardchemy-web
JWT_CLOCK_SKEW_SECONDS=30
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_SESSION_EXPIRE_DAYS=30
REFRESH_COOKIE_NAME=cardchemy_refresh
REFRESH_COOKIE_DOMAIN=
INVITATION_MIN_HOURS=1
INVITATION_MAX_HOURS=720
PASSWORD_RESET_EXPIRE_MINUTES=30

# Three independent AI capabilities. Keys are never implicitly shared. RAG is
# off by default; Phase 13 adds private Knowledge storage, not model execution.
# Before enabling any worker, set its explicit quota bucket and divide the
# account/project RPM and input TPM among every enabled profile and replica.
# A bucket is an operator label, not a distributed quota governor. Refresh
# provider prices/availability before authorizing paid calls.
FLASHCARD_AI_PROVIDER_ENABLED=false
FLASHCARD_AI_PROVIDER=gemini
FLASHCARD_AI_MODEL=gemini-3.8-flash
FLASHCARD_AI_API_KEY=
FLASHCARD_AI_BASE_URL=
FLASHCARD_AI_ALLOW_UNSTABLE_MODEL=false
FLASHCARD_AI_QUOTA_BUCKET=
# Transient calls receive at most three retries, each after at least 3 seconds.
FLASHCARD_AI_PROVIDER_MAX_RETRIES=3
FLASHCARD_AI_RETRY_BASE_SECONDS=3
FLASHCARD_AI_RETRY_MAX_SECONDS=30
FLASHCARD_AI_MAX_OUTPUT_TOKENS=8192
FLASHCARD_AI_TEMPERATURE=0.2
FLASHCARD_AI_CONTEXT_WINDOW_TOKENS=1048576
FLASHCARD_AI_PROVIDER_TIMEOUT_SECONDS=90
FLASHCARD_AI_CONCURRENCY=3
FLASHCARD_AI_REQUESTS_PER_MINUTE=5
FLASHCARD_AI_INPUT_TOKENS_PER_MINUTE=250000
FLASHCARD_AI_RATE_LIMIT_SAFETY_PERCENT=80
# Flashcard-only packing, grounding and refill controls.
FLASHCARD_AI_REQUEST_INPUT_TARGET_TOKENS=40000
FLASHCARD_AI_CARDS_PER_REQUEST=10
FLASHCARD_AI_CHUNK_INPUT_TOKENS=1200
FLASHCARD_AI_CHUNK_OVERLAP_TOKENS=120
FLASHCARD_AI_SUMMARY_OUTPUT_TOKENS=1024
FLASHCARD_AI_MAX_JOB_INPUT_TOKENS=200000
FLASHCARD_AI_MAX_JOB_OUTPUT_TOKENS=262144
FLASHCARD_AI_REFILL_ROUNDS=2
FLASHCARD_AI_DUPLICATE_SIMILARITY_THRESHOLD=0.88
FLASHCARD_AI_INPUT_COST_PER_MILLION_USD=0
FLASHCARD_AI_OUTPUT_COST_PER_MILLION_USD=0
FLASHCARD_AI_MAX_ESTIMATED_COST_USD=5

RAG_ENABLED=false
# Ask AI answer profile. Its separate answer worker is implemented in a later
# phase; enabling this profile does not enable Ask AI in the current release.
RAG_AI_PROVIDER_ENABLED=false
RAG_AI_PROVIDER=openai_compatible
RAG_AI_MODEL=gpt-4.1-mini-2025-04-14
RAG_AI_API_KEY=
RAG_AI_BASE_URL=https://api.openai.com/v1
RAG_AI_ALLOW_UNSTABLE_MODEL=false
RAG_AI_QUOTA_BUCKET=
RAG_AI_TEMPERATURE=0.2
RAG_AI_MAX_OUTPUT_TOKENS=2048
RAG_AI_CONTEXT_WINDOW_TOKENS=128000
RAG_AI_PROVIDER_TIMEOUT_SECONDS=90
RAG_AI_PROVIDER_MAX_RETRIES=3
RAG_AI_RETRY_BASE_SECONDS=3
RAG_AI_RETRY_MAX_SECONDS=30
RAG_AI_CONCURRENCY=1
RAG_AI_REQUESTS_PER_MINUTE=5
RAG_AI_INPUT_TOKENS_PER_MINUTE=250000
RAG_AI_RATE_LIMIT_SAFETY_PERCENT=80
RAG_AI_MAX_JOB_INPUT_TOKENS=40000
RAG_AI_MAX_JOB_OUTPUT_TOKENS=4096
RAG_AI_INPUT_COST_PER_MILLION_USD=0.40
RAG_AI_OUTPUT_COST_PER_MILLION_USD=1.60
RAG_AI_MAX_ESTIMATED_COST_USD=1

# Dedicated Knowledge indexing/query embedding profile. The index worker is
# implemented after Phase 13. The initial compatible vector space is explicit.
RAG_EMBEDDING_PROVIDER_ENABLED=false
RAG_EMBEDDING_PROVIDER=openai_compatible
RAG_EMBEDDING_MODEL=text-embedding-3-small
RAG_EMBEDDING_API_KEY=
RAG_EMBEDDING_BASE_URL=https://api.openai.com/v1
RAG_EMBEDDING_QUOTA_BUCKET=
RAG_EMBEDDING_DIMENSIONS=1536
RAG_EMBEDDING_FORMAT_VERSION=raw_text_v1
RAG_EMBEDDING_SPACE_REVISION=v1
RAG_EMBEDDING_REPRESENTATION=float32
RAG_EMBEDDING_METRIC=cosine
RAG_EMBEDDING_BATCH_SIZE=32
RAG_EMBEDDING_MAX_INPUT_TOKENS=8192
RAG_EMBEDDING_PROVIDER_TIMEOUT_SECONDS=90
RAG_EMBEDDING_PROVIDER_MAX_RETRIES=3
RAG_EMBEDDING_RETRY_BASE_SECONDS=3
RAG_EMBEDDING_RETRY_MAX_SECONDS=30
RAG_EMBEDDING_CONCURRENCY=1
RAG_EMBEDDING_REQUESTS_PER_MINUTE=5
RAG_EMBEDDING_INPUT_TOKENS_PER_MINUTE=250000
RAG_EMBEDDING_RATE_LIMIT_SAFETY_PERCENT=80
RAG_EMBEDDING_INPUT_COST_PER_MILLION_USD=0.02
RAG_EMBEDDING_MAX_ESTIMATED_COST_USD=1

# Optional OCR. Rebuild backend images after changing this to true.
PDF_OCR_ENABLED=false
PDF_OCR_LANGUAGE=eng
PDF_OCR_DPI=200
PDF_OCR_PAGE_TIMEOUT_SECONDS=30

# PDF admission/extraction limits. Byte values are raw bytes, not MiB.
PDF_MAX_UPLOAD_BYTES=10485760
PDF_MAX_PAGES=100
PDF_MAX_EXTRACTED_CHARS=500000
PDF_EXTRACTION_TIMEOUT_SECONDS=60
PDF_EXTRACTION_MEMORY_LIMIT_MB=512

# Base Compose uses Mailpit. Production requires a real relay, sender, and an
# explicit encrypted mode: exactly one of STARTTLS or implicit TLS must be true.
SMTP_HOST=
# Base Compose uses mailpit:1025; production must set the relay's actual port.
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=
SMTP_REPLY_TO=
SMTP_STARTTLS=false
SMTP_IMPLICIT_TLS=false
SMTP_TIMEOUT_SECONDS=15

# Optional email-worker queue, lease, retry, and retention bounds.
EMAIL_WORKER_CONCURRENCY=4
EMAIL_WORKER_POLL_SECONDS=1
EMAIL_LEASE_SECONDS=240
EMAIL_MAX_ATTEMPTS=5
EMAIL_RETRY_BASE_SECONDS=5
EMAIL_RETRY_MAX_SECONDS=300
EMAIL_CLEANUP_INTERVAL_SECONDS=3600
EMAIL_SENT_RETENTION_DAYS=7
EMAIL_FAILED_RETENTION_DAYS=30
EMAIL_SECURITY_NOTIFICATION_EXPIRE_HOURS=24

# Per-user and deployment admission/cost controls.
GENERATION_MIN_CARD_COUNT=1
GENERATION_MAX_CARD_COUNT=100
GENERATION_MAX_ACTIVE_JOBS_PER_USER=2
GENERATION_MAX_ACTIVE_JOBS_DEPLOYMENT=20
GENERATION_MAX_QUEUED_JOBS_DEPLOYMENT=100
GENERATION_DAILY_JOBS_PER_USER=20
GENERATION_DAILY_CARDS_PER_USER=500
GENERATION_DAILY_UPLOAD_BYTES_PER_USER=104857600
GENERATION_DAILY_JOBS_DEPLOYMENT=1000
GENERATION_DAILY_CARDS_DEPLOYMENT=50000
GENERATION_DAILY_UPLOAD_BYTES_DEPLOYMENT=10737418240
GENERATION_MAX_RETAINED_SOURCE_BYTES_PER_USER=52428800
GENERATION_MAX_RETAINED_SOURCE_BYTES_DEPLOYMENT=1073741824

# Optional generation-worker concurrency, leases, retry, and retention bounds.
GENERATION_WORKER_CONCURRENCY=2
GENERATION_JOB_TIMEOUT_SECONDS=600
GENERATION_LEASE_SECONDS=60
GENERATION_WORKER_POLL_SECONDS=1
GENERATION_HEARTBEAT_SECONDS=10
GENERATION_MAX_ATTEMPTS=3
GENERATION_MAX_MANUAL_RETRIES=2
GENERATION_RETRY_BASE_SECONDS=2
GENERATION_RETRY_MAX_SECONDS=60
GENERATION_SOURCE_RETRY_RETENTION_HOURS=24
GENERATION_UPLOAD_RESERVATION_MINUTES=15
GENERATION_CLEANUP_INTERVAL_SECONDS=60
