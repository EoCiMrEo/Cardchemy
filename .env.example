# Compose reads this root file. Generate unique values; never reuse a key.
POSTGRES_PASSWORD=
SECRET_KEY=
GENERATION_SOURCE_ENCRYPTION_KEY=

# Provider configuration. See docs/AI_PROVIDERS.md. AI_API_KEY may be empty for
# a trusted local OpenAI-compatible endpoint; Gemini requires it (or the legacy
# GEMINI_API_KEY fallback).
AI_PROVIDER=gemini
AI_MODEL=gemini-3.8-flash
AI_API_KEY=
GEMINI_API_KEY=
AI_BASE_URL=
AI_INPUT_COST_PER_MILLION_USD=0
AI_OUTPUT_COST_PER_MILLION_USD=0
AI_MAX_ESTIMATED_COST_USD=5

# OCR is opt-in because it increases image size, CPU use, and job latency.
PDF_OCR_ENABLED=false
