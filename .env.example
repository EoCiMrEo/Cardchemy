# Copying this file verbatim is intentionally insufficient: the three secret
# fields below are empty. Run `python scripts/bootstrap_env.py` to create .env
# once with independent random values without printing them.

# Compose and local public ports
APP_PORT=8080
API_PORT=8000
POSTGRES_PORT=5432
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025

# PostgreSQL (the bootstrap script fills POSTGRES_PASSWORD)
POSTGRES_DB=flashcard_gen
POSTGRES_USER=admin
POSTGRES_PASSWORD=

# Application identity and generated secrets
APP_NAME=Flashcard Generator
APP_VERSION=0.1.0
SECRET_KEY=
GENERATION_SOURCE_ENCRYPTION_KEY=

# Safe local defaults. The production override replaces or requires these.
ENVIRONMENT=development
DEBUG=false
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax
FRONTEND_BASE_URL=
CORS_ORIGINS=
API_DOCS_ENABLED=
API_ROOT_PATH=/api
VITE_API_URL=/api
WORKER_SHUTDOWN_GRACE_SECONDS=30

# Provider configuration. The stack starts without a provider key, but PDF/AI
# generation remains unavailable until this explicit switch is enabled and a
# supported provider is configured. Provider credentials reach only the worker.
AI_PROVIDER_ENABLED=false
AI_PROVIDER=gemini
AI_MODEL=gemini-3.8-flash
AI_API_KEY=
GEMINI_API_KEY=
AI_BASE_URL=
AI_ALLOW_UNSTABLE_MODEL=false
# Transient calls receive three retries, each after a three-second wait.
AI_PROVIDER_MAX_RETRIES=3
AI_RETRY_BASE_SECONDS=3
AI_RETRY_MAX_SECONDS=30
AI_MAX_OUTPUT_TOKENS=8192
# Shared worker-wide provider budget. The 80% safety margin turns these
# provider limits into effective budgets of 4 RPM and 200,000 input TPM.
AI_REQUESTS_PER_MINUTE=5
AI_INPUT_TOKENS_PER_MINUTE=250000
AI_RATE_LIMIT_SAFETY_PERCENT=80
# Preserve small grounded chunks, then pack them into larger provider calls.
AI_REQUEST_INPUT_TARGET_TOKENS=40000
AI_CARDS_PER_REQUEST=10
AI_INPUT_COST_PER_MILLION_USD=0
AI_OUTPUT_COST_PER_MILLION_USD=0
AI_MAX_ESTIMATED_COST_USD=5

# Optional OCR. Rebuild backend images after changing this to true.
PDF_OCR_ENABLED=false
PDF_OCR_LANGUAGE=eng
PDF_OCR_DPI=200
PDF_OCR_PAGE_TIMEOUT_SECONDS=30

# Base Compose uses Mailpit. Production requires a real relay, sender, and an
# explicit encrypted mode: exactly one of STARTTLS or implicit TLS must be true.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=
SMTP_REPLY_TO=
SMTP_STARTTLS=
SMTP_IMPLICIT_TLS=
SMTP_TIMEOUT_SECONDS=15

# Detailed resource, retry, retention, and auth settings retain conservative
# application defaults. See backend/.env.example and docs/DEPLOYMENT.md.
